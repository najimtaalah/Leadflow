# ── SERVEUR ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── BASE DE DONNÉES ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_db
DB_NAME=leadflow_crm

# ── JWT ────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── SÉCURITÉ ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── LOGS ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── SMTP (envoi d'emails automatiques — Agent IA CMA) ──────────
# Si non configuré : les emails sont simulés (loggés uniquement)
# Gmail : activer "Mots de passe d'application" dans la sécurité Google
# OVH   : SMTP_HOST=ssl0.ovh.net  SMTP_PORT=465
# Brevo : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM=LeadFlow CRM <votre@email.com>

# ── Ollama (Agent IA — génération de contenu) ───────────────────
# Installer : https://ollama.com  puis : ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── CMA (résultats examens — optionnel) ────────────────────────
# Laisser vide pour rester en mode simulation
# CMA_BASE_URL=https://portail.cma-france.fr
