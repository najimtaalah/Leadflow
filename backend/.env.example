# Base de données
DATABASE_URL="postgresql://leadflow:leadflow@localhost:5432/leadflow"

# JWT
JWT_SECRET="change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars"
